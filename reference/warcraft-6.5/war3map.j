endfunction
function v2 takes nothing returns boolean
return(GetUnitTypeId(GetDyingUnit())=='H02Q')or(GetUnitTypeId(GetDyingUnit())=='o00D')
endfunction
function e2 takes nothing returns boolean
return(v2())
endfunction
function x2 takes nothing returns boolean
return(pv>=5)and(GetUnitTypeId(GetDyingUnit())=='H02Q')
endfunction
function o2 takes nothing returns boolean
return(pv<=4)and(GetUnitTypeId(GetDyingUnit())=='o00D')
endfunction
