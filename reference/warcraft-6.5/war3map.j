function ep takes nothing returns nothing
call SetPlayerTechMaxAllowedSwap('o008',7,GetOwningPlayer(GetDyingUnit()))
call SetPlayerTechMaxAllowedSwap('o004',2,GetOwningPlayer(GetDyingUnit()))
call SetPlayerTechMaxAllowedSwap('o00M',3,GetOwningPlayer(GetDyingUnit()))
call CreateNUnitsAtLoc(1,'o00D',GetOwningPlayer(GetDyingUnit()),GetRectCenter(Vo),bj_UNIT_FACING)
set Xe[(1+GetPlayerId(GetTriggerPlayer()))]=bj_lastCreatedUnit
call SetUnitInvulnerable(Xe[(1+GetPlayerId(GetTriggerPlayer()))],true)
call ab(300.,GetUnitLoc(bj_lastCreatedUnit),function vp)
call PanCameraToTimedLocForPlayer(GetOwningPlayer(bj_lastCreatedUnit),GetUnitLoc(bj_lastCreatedUnit),1.)
call DisplayTimedTextToForce(fb(GetOwningPlayer(bj_lastCreatedUnit)),30,"你突然变成了一只恐龙。")
call DisplayTimedTextToForce(fb(GetOwningPlayer(bj_lastCreatedUnit)),30,"你可以协助其他幸存者，但是无法登上救援直升机。")
call DisplayTimedTextToForce(fb(GetOwningPlayer(bj_lastCreatedUnit)),30,"30秒后恐龙依然会攻击你。 ")
call TriggerSleepAction(30.)
call SetUnitInvulnerable(Xe[(1+GetPlayerId(GetTriggerPlayer()))],false)
endfunction
