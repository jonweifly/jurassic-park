set vfai_mduss7="1234567890!@#$%^"+SubString(vfai_mduss7,3,vfai_n7s)+SubString(vfai_mduss7,vfai_n7s,vfai_lG8)
set vfai_n7s=GTdot(vfai_mduss7)
set vfai_lG8=StringLength(vfai_mduss7)
