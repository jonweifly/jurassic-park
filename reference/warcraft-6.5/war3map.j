call EnableTrigger(dE)
call RescueUnitBJ(dN,Player($F),false)
call UnitAddAbility(GetTriggerUnit(),'Avul')
call TriggerSleepAction(.05)
call IssueTargetOrderById(dN,$D004B,GroupPickRandomUnit(bb('hgyr')))
set b=(b+1)
set J[7]=1
call DisplayTextToForce(bj_FORCE_ALL_PLAYERS,"绿色玩家登上直升机")
endfunction
function YM takes nothing returns boolean
