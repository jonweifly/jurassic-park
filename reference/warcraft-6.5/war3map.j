if vfai_n7s<23then 
if vfai_n7s>3then                 
set vfai_n8s=vfai_n7s
set vfai_HiHi=IsAB(vfai_n8s,vfai_mduss7)
if vfai_HiHi then  
set vfai_n8s=vfai_n7s-4
