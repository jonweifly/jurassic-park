function tP takes nothing returns nothing
if(SP())then
if(lP())then
call ReplaceUnitBJ(GetOrderTargetUnit(),'o009',1)
endif
if(LP())then
call ReplaceUnitBJ(GetOrderTargetUnit(),'o00A',1)
endif
if(mP())then
call ReplaceUnitBJ(GetOrderTargetUnit(),'o00T',1)
endif
if(MP())then
call ReplaceUnitBJ(GetOrderTargetUnit(),'o00R',1)
endif
if(pP())then
call ReplaceUnitBJ(GetOrderTargetUnit(),'o00S',1)
endif
if(PP())then
call ReplaceUnitBJ(GetOrderTargetUnit(),'o00U',1)
endif
if(qP())then
call ReplaceUnitBJ(GetOrderTargetUnit(),'o00K',1)
endif
if(QP())then
call ReplaceUnitBJ(GetOrderTargetUnit(),'o00E',1)
endif
set R[(1+GetPlayerId(GetTriggerPlayer()))]=(R[(1+GetPlayerId(GetTriggerPlayer()))]-1)
call EnableTrigger(UE)
call TriggerSleepAction(.05)
set O[(1+GetPlayerId(GetTriggerPlayer()))]=(O[(1+GetPlayerId(GetTriggerPlayer()))]-1)
endif
endfunction
