function kP takes nothing returns nothing
call DisableTrigger(GetTriggeringTrigger())
call DisplayTextToForce(fb(GetTriggerPlayer()),"训练开始...")
call zN(.2)
call DisplayTextToForce(fb(GetTriggerPlayer()),(x[(1+GetPlayerId(GetOwningPlayer(GetTriggerUnit())))]+(GetPlayerName(GetTriggerPlayer())+(": Now this is a stick.. Bring it to me."+" "))))
call zN(.2)
call DisplayTextToForce(fb(GetTriggerPlayer()),"*你抛出木棒*")
call zN(.4)
if(BP())then
else
call DisplayTextToForce(fb(GetTriggerPlayer()),"训练终止")
call EnableTrigger(GetTriggeringTrigger())
return
endif
call DisplayTextToForce(fb(GetTriggerPlayer()),(x[(1+GetPlayerId(GetOwningPlayer(GetTriggerUnit())))]+(GetPlayerName(GetTriggerPlayer())+(": 被盯着我看，去叼木棒！"+" "))))
call zN(3.)
call DisplayTextToForce(fb(GetTriggerPlayer()),"*你再次抛出木棒*")
call zN(3.)
call DisplayTextToForce(fb(GetTriggerPlayer()),(x[(1+GetPlayerId(GetOwningPlayer(GetTriggerUnit())))]+(GetPlayerName(GetTriggerPlayer())+(": 我抛木棒的时候别咬我胳膊！"+" "))))
call zN(3.)
call DisplayTextToForce(fb(GetTriggerPlayer()),"*你抛出木棒，恐龙快速的叼住木棒，远远的盯着你看。*")
if(dP())then
else
call DisplayTextToForce(fb(GetTriggerPlayer()),"训练终止")
call EnableTrigger(GetTriggeringTrigger())
return
endif
call zN(4.)
call DisplayTextToForce(fb(GetTriggerPlayer()),"*它好像明白了伐木是怎么回事*")
call zN(3.)
if(FP())then
else
call DisplayTextToForce(fb(GetTriggerPlayer()),"训练终止")
call EnableTrigger(GetTriggeringTrigger())
return
endif
call DisplayTextToForce(fb(GetTriggerPlayer()),(x[(1+GetPlayerId(GetOwningPlayer(GetTriggerUnit())))]+(GetPlayerName(GetTriggerPlayer())+(": 好了，把木棒交给我。"+" "))))
call zN(6.)
if(hP())then
else
call DisplayTextToForce(fb(GetTriggerPlayer()),"训练终止")
call EnableTrigger(GetTriggeringTrigger())
return
endif
call DisplayTextToForce(fb(GetTriggerPlayer()),"*恐龙跳过来把你踩在脚下*")
call zN(3.)
call DisplayTextToForce(fb(GetTriggerPlayer()),"*你终于慢慢的站起身*")
call zN(3.)
if(JP())then
else
call DisplayTextToForce(fb(GetTriggerPlayer()),"训练终止")
call EnableTrigger(GetTriggeringTrigger())
return
endif
set R[(1+GetPlayerId(GetTriggerPlayer()))]=(R[(1+GetPlayerId(GetTriggerPlayer()))]+1)
call DisplayTextToForce(fb(GetTriggerPlayer()),(x[(1+GetPlayerId(GetOwningPlayer(GetTriggerUnit())))]+(GetPlayerName(GetTriggerPlayer())+(": 真见鬼！不过它好像明白了"+" "))))
call DisplayTextToForce(fb(GetTriggerPlayer()),"训练成功!!! 你的恐龙学会了伐木。")
endfunction
